{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "$type": "color",
    "primary": { "$value": "{color.blue.600}" },
    "ai": { "$value": "{color.purple.700}" },
    "theme": {
      "light": {
        "primary": { "$value": "{color.blue.600}" },
        "ai": { "$value": "{color.purple.700}" },
        "surface": {
