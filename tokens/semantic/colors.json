      },
      "error": {
        "foreground": { "$value": "{color.theme.light.status.error.foreground}" },
        "surface": { "$value": "{color.theme.light.status.error.surface}" }
      },
      "warning": {
        "foreground": { "$value": "{color.theme.light.status.warning.foreground}" },
        "surface": { "$value": "{color.theme.light.status.warning.surface}" }
      },
      "info": {
        "foreground": { "$value": "{color.theme.light.status.info.foreground}" },
        "surface": { "$value": "{color.theme.light.status.info.surface}" }
      }
    }
