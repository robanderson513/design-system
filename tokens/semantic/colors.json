          "selected": {
            "foreground": { "$value": "{color.blue.100}" },
            "surface": { "$value": "{color.blue.950}" },
            "border": { "$value": "{color.blue.700}" }
          },
          "invalid": {
            "foreground": { "$value": "{color.red.200}" },
            "surface": { "$value": "{color.red.950}" },
            "border": { "$value": "{color.red.700}" }
          }
        }
      }
    },
    "surface": {
      "default": { "$value": "{color.theme.light.surface.default}" },
      "subtle": { "$value": "{color.theme.light.surface.subtle}" },
      "inverse": { "$value": "{color.theme.light.surface.inverse}" }
    },
    "text": {
      "primary": { "$value": "{color.theme.light.text.primary}" },
      "secondary": { "$value": "{color.theme.light.text.secondary}" },
      "muted": { "$value": "{color.theme.light.text.muted}" },
      "inverse": { "$value": "{color.theme.light.text.inverse}" }
