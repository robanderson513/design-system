{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": "rgba(23, 23, 23, 0.08)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "md": {
      "$value": {
        "color": "rgba(23, 23, 23, 0.12)",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "0px"
      }
    },
    "lg": {
      "$value": {
        "color": "rgba(23, 23, 23, 0.16)",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "24px",
        "spread": "0px"
      }
    }
  }
}
